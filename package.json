{
  "name": "@toreador/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the Toreador API: fiat-denominated crypto checkouts paid in stablecoins (USDC, USDT, EURC) or native crypto, QR codes, payment status, webhooks with HMAC-signed events, accounting export. Non-custodial.",
  "license": "MIT",
  "author": "Toreador <dev@toreador.io> (https://toreador.io)",
  "homepage": "https://toreador.io/docs#sdk",
  "bugs": {
    "url": "https://github.com/Logitale/toreador-sdk/issues",
    "email": "dev@toreador.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logitale/toreador-sdk.git"
  },
  "funding": "https://toreador.io/pricing",
  "keywords": [
    "toreador",
    "crypto",
    "crypto-payments",
    "stablecoin",
    "usdc",
    "usdt",
    "eurc",
    "checkout",
    "non-custodial",
    "qr-code",
    "bitcoin",
    "ethereum",
    "solana",
    "base",
    "polygon",
    "webhooks",
    "hmac",
    "sdk",
    "typescript-sdk",
    "api-client",
    "web3-payments"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
