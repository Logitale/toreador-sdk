{
  "name": "@toreador/sdk",
  "version": "0.1.2",
  "description": "Official TypeScript SDK for the Toreador crypto QR code API. Generate Bitcoin, Ethereum, Solana, Polygon QR codes and create non-custodial USDC / USDT / EURC payment sessions with HMAC-signed webhooks.",
  "license": "MIT",
  "author": "Toreador <dev@toreador.io> (https://toreador.io)",
  "homepage": "https://toreador.io/docs#sdk",
  "bugs": {
    "url": "https://github.com/Logitale/toreador-sdk/issues",
    "email": "dev@toreador.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logitale/toreador-sdk.git"
  },
  "funding": "https://toreador.io/pricing",
  "keywords": [
    "toreador",
    "crypto",
    "qr-code",
    "qrcode",
    "crypto-qr-code",
    "bitcoin-qr-code",
    "ethereum-qr-code",
    "solana-pay",
    "payment-sessions",
    "stablecoin",
    "usdc",
    "usdt",
    "eurc",
    "non-custodial",
    "sdk",
    "typescript-sdk",
    "api-client",
    "bip-21",
    "eip-681",
    "webhooks",
    "hmac",
    "bitcoin",
    "ethereum",
    "solana",
    "polygon",
    "crypto-payments",
    "web3-payments"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
